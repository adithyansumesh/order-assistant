# Order Assistant Environment Configuration

# AI Provider Credentials (Provide either OpenAI or Groq API key)
OPENAI_API_KEY=your_openai_api_key_here
# GROQ_API_KEY=gsk_your_groq_api_key_here

# AI Model configuration
# For OpenAI: gpt-4o-mini (default), gpt-4o
# For Groq: llama-3.3-70b-versatile, openai/gpt-oss-20b
OPENAI_MODEL=gpt-4o-mini

# Optional Custom Base URL (Automatically set to https://api.groq.com/openai/v1 if using gsk_ key)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Frontend API URL configuration (leave blank for local development / unified deployments)
# Set to your deployed backend URL in Vercel project settings (e.g. https://order-assistant-api.onrender.com)
VITE_API_BASE_URL=

# Server Port and Host
PORT=8000
HOST=0.0.0.0

# Optional path override for orders dataset
# ORDERS_CSV_PATH=orders.csv
