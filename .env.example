# Order Assistant Environment Configuration

# OpenAI API credentials (Required for chat agent)
OPENAI_API_KEY=your_openai_api_key_here

# Model to use for tool calling (e.g., gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Optional path override for orders.csv (defaults to orders.csv relative to project root)
# ORDERS_CSV_PATH=orders.csv

# Server Port (configured automatically by Render in production)
PORT=8000
HOST=0.0.0.0
